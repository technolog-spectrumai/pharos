#!/bin/sh
set -e
if [ "$1" = configure ]; then
  adduser --system --group --home /var/lib/proteus --no-create-home proteus >/dev/null 2>&1 || true
  install -d -o proteus -g proteus -m 0700 /var/lib/proteus /etc/proteus
  [ -f /etc/proteus/config.yaml ] || install -o proteus -g proteus -m 0600 /etc/proteus/config.yaml.example /etc/proteus/config.yaml
  runuser -u proteus -- /usr/bin/proteus init -c /etc/proteus/config.yaml || true
  echo "Proteus installed. Start it: sudo systemctl enable --now proteus"
  echo "Its address: sudo -u proteus proteus status -c /etc/proteus/config.yaml"
fi
#DEBHELPER#
