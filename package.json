  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "typescript": "~5.6.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.38",
    "vue-i18n": "^9.14.5",
    "yaml": "^2.9.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2"
  }
}
