import { Theme } from "theme.slint";

// A letter avatar: first letter of the nickname, white on its palette colour.
export component Avatar inherits Rectangle {
    in property <string> letter: "?";
    in property <color> colour: #55606e;
    in property <length> size: 36px;
    width: size;
    height: size;
    border-radius: size / 2;
    background: colour;
    Text {
        text: letter;
        color: white;
        font-size: size * 0.46;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A flat icon button (☰, ⋮, ←).
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <color> fg: Theme.header-text;
    callback clicked;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: ta.has-hover ? #ffffff20 : transparent;
    ta := TouchArea { clicked => { root.clicked(); } }
    Text {
        text: icon;
        color: fg;
        font-size: 20px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A filled button in the accent colour.
export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;
    min-width: 96px;
    height: 38px;
    border-radius: 8px;
    background: !enabled ? Theme.border : ta.pressed ? Theme.accent.darker(20%) : ta.has-hover ? Theme.accent.brighter(15%) : Theme.accent;
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    Text {
        text: root.text;
        color: white;
        font-size: Theme.font;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A white rounded card with a title.
export component Card inherits Rectangle {
    in property <string> title;
    background: Theme.panel;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        if root.title != "" : Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.font-large;
            font-weight: 700;
        }
        @children
    }
}

// One row in a popup menu.
export component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    callback clicked;
    height: 40px;
    background: ta.has-hover ? Theme.selected : transparent;
    ta := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text {
            text: root.text;
            color: root.danger ? Theme.warn : Theme.text;
            font-size: Theme.font;
            vertical-alignment: center;
        }
    }
}

// A text button (secondary actions; red when dangerous).
export component FlatButton inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked;
    min-width: 72px;
    height: 38px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.selected : transparent;
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            color: !root.enabled ? Theme.muted : root.danger ? Theme.warn : Theme.accent.brighter(Theme.dark ? 80% : 0%);
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
