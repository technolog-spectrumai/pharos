// Colours from the Vue app (apps/enigma tailwind tokens: primary-bg, bubble-bg, header-bg,
// accent) and the letter-avatar palette (avatarIcon.ts). Light/dark follows the system;
// Rust switches it with AppWindow.set-dark (screenshots), which sets
// Palette.color-scheme so the std widgets (LineEdit, ComboBox) follow too.
import { Palette } from "std-widgets.slint";

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    out property <color> bg: dark ? #0a0c11 : #f2f3f5;          // primary-bg
    out property <color> panel: dark ? #191f2d : #ffffff;       // bubble-bg (panels)
    out property <color> panel-2: dark ? #151b29 : #e8e9ec;     // appbar / composer
    out property <color> header: dark ? #0f1420 : #1d2333;      // header-bg (dark in both)
    out property <color> header-text: #f2f3f5;
    out property <color> border: dark ? #2a3245 : #d5d8de;
    out property <color> text: dark ? #e6e8ee : #1b1f2a;
    out property <color> muted: dark ? #8a93a6 : #5d6474;
    out property <color> accent: dark ? #4f5fa1 : #2f3d63;      // accent-dark / accent-light
    out property <color> own-bubble: #4f5bc4;                   // ChatBubble self
    out property <color> own-text: #ffffff;
    out property <color> other-bubble: dark ? #2a303d : #eceef2;  // black/5 · white/10
    out property <color> selected: dark ? #232b3f : #dfe3f1;
    out property <color> ok: #2f8f6f;
    out property <color> warn: #c2553f;
    out property <color> beacon-on: #2f8f6f;                    // Lighthouse switch
    out property <color> beacon-off: dark ? #2a3245 : #dfe3ea;

    out property <length> radius: 10px;
    out property <length> gap: 8px;
    out property <length> font-small: 12px;
    out property <length> font: 14px;
    out property <length> font-large: 18px;
}
