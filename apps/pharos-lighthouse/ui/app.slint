// Pharos Lighthouse: run and manage a Beacon. State comes from Rust (src/lib.rs on
// src/model.rs); the .slint files lay it out and raise callbacks.
import { LineEdit, ScrollView, Switch, Palette, ComboBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { PrimaryButton, Card, BeaconToggle } from "widgets.slint";

export { Theme }

export enum LhScreen { overview, clients, rooms, settings, log }

export struct LhClient { id: string, online: bool, seen: string, rooms: int, queued: string }
export struct LhRoom { id: string, online: int, members: int, linked: string, queued: string }
export struct LhLog { time: string, text: string, kind: int }   // 0 info, 1 good, 2 bad

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> active;
    in property <string> badge;
    callback clicked;
    height: 44px;
    border-radius: 8px;
    background: active ? Theme.selected : ta.has-hover ? Theme.selected.with-alpha(0.5) : transparent;
    ta := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 10px;
        Text { text: root.icon; font-size: 16px; color: Theme.text; vertical-alignment: center; width: 22px; }
        Text { text: root.text; font-size: Theme.font; font-weight: root.active ? 700 : 400; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
        if root.badge != "" : Rectangle {
            y: (parent.height - 20px) / 2;
            height: 20px;
            min-width: 24px;
            border-radius: 10px;
            background: Theme.accent;
            Text { text: root.badge; color: white; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}

component Dot inherits Rectangle {
    in property <color> c;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background: c;
}

component SmallButton inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    callback clicked;
    height: 30px;
    min-width: 64px;
    border-radius: 6px;
    border-width: 1px;
    border-color: danger ? Theme.warn : Theme.border;
    background: ta.pressed ? Theme.selected : ta.has-hover ? Theme.selected.with-alpha(0.6) : Theme.panel;
    ta := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text { text: root.text; color: root.danger ? Theme.warn : Theme.text; font-size: Theme.font-small; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
    }
}

component KeyValue inherits HorizontalLayout {
    in property <string> key;
    in property <string> value;
    in property <color> value-color: Theme.text;
    spacing: 12px;
    Text { text: root.key; color: Theme.muted; font-size: Theme.font; width: 150px; vertical-alignment: center; }
    Text { text: root.value; color: root.value-color; font-size: Theme.font; wrap: char-wrap; horizontal-stretch: 1; min-width: 0px; vertical-alignment: center; }
}

component Stat inherits Rectangle {
    in property <string> value;
    in property <string> label;
    background: Theme.panel;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    min-height: 76px;
    VerticalLayout {
        padding: 14px;
        spacing: 2px;
        alignment: center;
        Text { text: root.value; color: Theme.text; font-size: 24px; font-weight: 800; }
        Text { text: root.label; color: Theme.muted; font-size: Theme.font-small; }
    }
}

component TableHead inherits Rectangle {
    in property <[string]> cols;
    in property <[float]> weights;
    height: 32px;
    border-radius: 6px;
    background: Theme.panel-2;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        for c[i] in root.cols : Text { text: c; color: Theme.muted; font-size: Theme.font-small; font-weight: 700; vertical-alignment: center; horizontal-stretch: root.weights[i]; preferred-width: 0px; min-width: 0px; }
    }
}

component Cell inherits Text {
    color: Theme.text;
    font-size: Theme.font;
    vertical-alignment: center;
    overflow: elide;
    preferred-width: 0px;
    min-width: 0px;
}

component ScreenTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> sub;
    spacing: 2px;
    Text { text: root.title; color: Theme.text; font-size: 22px; font-weight: 800; }
    if root.sub != "" : Text { text: root.sub; color: Theme.muted; font-size: Theme.font-small; wrap: word-wrap; }
}

component Field inherits VerticalLayout {
    in property <string> label;
    in-out property <string> value;
    in property <string> unit;
    spacing: 4px;
    Text { text: root.label; color: Theme.muted; font-size: Theme.font-small; }
    HorizontalLayout {
        spacing: 6px;
        LineEdit { text <=> root.value; input-type: number; horizontal-stretch: 1; }
        if root.unit != "" : Text { text: root.unit; color: Theme.muted; font-size: Theme.font-small; vertical-alignment: center; width: 44px; }
    }
}

/// The Lighthouse's state and callbacks: Rust (src/glue.rs) talks to this global, so the
/// same view runs in this app's window and inside enigma27-combo's.
export global Lh {

    /// 0 system, 1 light, 2 dark (Settings → Appearance).
    in-out property <int> theme-choice: 0;
    callback set-theme(int);

    in-out property <LhScreen> screen: LhScreen.overview;
    in-out property <bool> demo;

    // Overview
    in-out property <bool> on;                 // switch position (running or starting)
    in-out property <string> phase: "off";
    in-out property <int> phase-kind;          // 0 off, 1 working, 2 online, 3 error
    in-out property <string> error;
    in-out property <string> onion;
    in-out property <string> code;
    in-out property <image> qr;
    in-out property <string> uptime;
    in-out property <string> tor;
    in-out property <int> clients-online;
    in-out property <int> clients-total;
    in-out property <int> rooms-total;
    in-out property <int> links-total;
    in-out property <string> toast;

    // Clients
    in-out property <[LhClient]> clients;
    in-out property <bool> restricted;
    in-out property <bool> restart-needed;
    in-out property <[string]> allowed;
    in-out property <string> allow-message;
    in-out property <bool> allow-error;
    in-out property <string> allow-name;
    in-out property <string> allow-key;

    // Rooms
    in-out property <[LhRoom]> rooms;

    // Settings
    in-out property <string> name;
    in-out property <string> data-dir;
    in-out property <string> key-status;
    in-out property <bool> key-ok;
    in-out property <string> disk-status;
    in-out property <bool> disk-ok;
    in-out property <bool> page-on;
    in-out property <string> max-clients;
    in-out property <string> queue-frames;
    in-out property <string> queue-mb;
    in-out property <string> queue-days;
    in-out property <string> message-days;
    in-out property <string> release-delay;
    in-out property <string> backup-path;
    in-out property <string> settings-message;
    in-out property <bool> settings-error;

    // Log
    in-out property <[LhLog]> log;

    callback toggle();
    callback copied(string);
    callback allow();
    callback deny(string);
    callback set-restricted(bool);
    callback save-settings();
    callback set-page(bool);
    callback backup();
    callback recheck();

}

/// The whole Lighthouse UI (sidebar + screens), without a window.
export component LighthouseView inherits Rectangle {
    background: Theme.bg;
    // A hidden text field to put text on the clipboard.
    clip := TextInput { visible: false; width: 0px; height: 0px; }
    function copy(t: string, what: string) {
        clip.text = t;
        clip.select-all();
        clip.copy();
        Lh.copied(what);
    }

    HorizontalLayout {
        // Sidebar ─────────────────────────────────────────────────────────
        Rectangle {
            width: 210px;
            background: Theme.panel;
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
            VerticalLayout {
                padding: 12px;
                spacing: 4px;
                Rectangle {
                    height: 64px;
                    border-radius: Theme.radius;
                    background: Theme.header;
                    HorizontalLayout {
                        padding-left: 12px;
                        spacing: 10px;
                        Text { text: "⛯"; color: Theme.header-text; font-size: 26px; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            Text { text: "Lighthouse"; color: Theme.header-text; font-size: Theme.font-large; font-weight: 800; }
                            HorizontalLayout {
                                spacing: 6px;
                                Dot { y: (parent.height - 10px) / 2; c: Lh.phase-kind == 2 ? #4fc1b0 : Lh.phase-kind == 1 ? #e0b55f : Lh.phase-kind == 3 ? #e07a5f : #8a93a6; }
                                Text { text: Lh.phase; color: #f2f3f5c0; font-size: 11px; }
                            }
                        }
                    }
                }
                Rectangle { height: 8px; }
                NavItem { icon: "⏻"; text: "Overview"; active: Lh.screen == LhScreen.overview; clicked => { Lh.screen = LhScreen.overview; } }
                NavItem { icon: "📱"; text: "Clients"; badge: Lh.clients-online > 0 ? Lh.clients-online : ""; active: Lh.screen == LhScreen.clients; clicked => { Lh.screen = LhScreen.clients; } }
                NavItem { icon: "#"; text: "Rooms"; badge: Lh.rooms-total > 0 ? Lh.rooms-total : ""; active: Lh.screen == LhScreen.rooms; clicked => { Lh.screen = LhScreen.rooms; } }
                NavItem { icon: "⚙"; text: "Settings"; active: Lh.screen == LhScreen.settings; clicked => { Lh.screen = LhScreen.settings; } }
                NavItem { icon: "☰"; text: "Log"; active: Lh.screen == LhScreen.log; clicked => { Lh.screen = LhScreen.log; } }
                Rectangle { vertical-stretch: 1; }
                if Lh.demo : Text { text: "demo mode: fake clients and rooms"; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                Text { text: "Counts and ids only: a Lighthouse never sees names or messages."; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
            }
        }

        // Content ─────────────────────────────────────────────────────────
        Rectangle {
            horizontal-stretch: 1;
            // Overview
            if Lh.screen == LhScreen.overview : sv1 := ScrollView {
                VerticalLayout {
                    width: sv1.visible-width;
                    padding: 24px;
                    spacing: 16px;
                    ScreenTitle { title: "Overview"; sub: "Your Lighthouse keeps messages for your phones while they are away and links them to friends' Lighthouses, over Tor only."; }
                    BeaconToggle {
                        on: Lh.on;
                        label-on: "Lighthouse is " + Lh.phase;
                        label-off: "Start Lighthouse";
                        detail: Lh.phase-kind == 3 ? Lh.error : Lh.on ? (Lh.uptime != "" ? "up " + Lh.uptime + " · tap to stop" : "tap to stop") : "off · tap to start serving on an onion service";
                        toggled => { Lh.toggle(); }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Stat { value: Lh.clients-online + " / " + Lh.clients-total; label: "phones online / known"; horizontal-stretch: 1; }
                        Stat { value: Lh.rooms-total; label: "rooms"; horizontal-stretch: 1; }
                        Stat { value: Lh.links-total; label: "Lighthouse links"; horizontal-stretch: 1; }
                        Stat { value: Lh.uptime == "" ? "—" : Lh.uptime; label: "uptime"; horizontal-stretch: 1; }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        alignment: stretch;
                        Card {
                            title: "Address";
                            horizontal-stretch: 1;
                            KeyValue { key: "State"; value: Lh.phase; value-color: Lh.phase-kind == 3 ? Theme.warn : Lh.phase-kind == 2 ? Theme.ok : Theme.text; }
                            KeyValue { key: "Tor"; value: Lh.tor; }
                            KeyValue { key: "Onion"; value: Lh.onion == "" ? "made when first served over Tor" : Lh.onion; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                SmallButton { text: "Copy address"; clicked => { root.copy(Lh.onion, "address"); } }
                                SmallButton { text: "Copy code"; clicked => { root.copy(Lh.code, "code"); } }
                            }
                            if Lh.toast != "" : Text { text: Lh.toast; color: Theme.ok; font-size: Theme.font-small; }
                            Text {
                                text: "In Enigma27: Settings → Your Beacon → \"Scan its code\", or paste the code and tap \"Use\". Phones on the list (Clients) can find it when \"Only my phones\" is on.";
                                color: Theme.muted; font-size: Theme.font-small; wrap: word-wrap;
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                        Card {
                            title: "Lighthouse code";
                            width: 300px;
                            if Lh.code != "" : Rectangle {
                                height: 264px;
                                background: white;
                                border-radius: 8px;
                                Image { source: Lh.qr; width: 256px; height: 256px; image-rendering: pixelated; }
                            }
                            if Lh.code == "" : Rectangle {
                                height: 264px;
                                background: Theme.panel-2;
                                border-radius: 8px;
                                Text { text: "No code yet: start the Lighthouse\nonce to make its address."; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Text { text: Lh.code; color: Theme.muted; font-size: 10px; wrap: char-wrap; min-width: 0px; }
                        }
                    }
                }
            }

            // Clients
            if Lh.screen == LhScreen.clients : VerticalLayout {
                padding: 24px;
                spacing: 14px;
                ScreenTitle { title: "Clients"; sub: "Phones attached now and recently. Ids are each phone's device key; nothing here says who owns it."; }
                TableHead { cols: ["Device", "State", "Last seen", "Rooms", "Queued for it"]; weights: [2, 1, 1.4, 0.8, 1.6]; }
                Rectangle {
                    vertical-stretch: 1;
                    min-height: 120px;
                    if Lh.clients.length == 0 : Text { text: Lh.on ? "No phone has attached yet." : "The Lighthouse is off."; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                    ScrollView {
                        VerticalLayout {
                            alignment: start;
                            for c in Lh.clients : Rectangle {
                                height: 40px;
                                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 8px;
                                    Cell { text: c.id; horizontal-stretch: 2; font-family: "monospace"; }
                                    HorizontalLayout {
                                        horizontal-stretch: 1;
                                        preferred-width: 0px;
                                        spacing: 6px;
                                        Dot { y: (parent.height - 10px) / 2; c: c.online ? Theme.ok : Theme.border; }
                                        Cell { text: c.online ? "online" : "offline"; color: c.online ? Theme.ok : Theme.muted; horizontal-stretch: 1; }
                                    }
                                    Cell { text: c.seen; horizontal-stretch: 1.4; color: Theme.muted; }
                                    Cell { text: c.rooms; horizontal-stretch: 0.8; }
                                    Cell { text: c.queued; horizontal-stretch: 1.6; }
                                }
                            }
                        }
                    }
                }
                Card {
                    title: "Only my phones";
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: "When on, only phones on this list can find the Lighthouse's onion (Tor client authorisation). Mailbox tokens still guard each mailbox when off.";
                            color: Theme.muted; font-size: Theme.font-small; wrap: word-wrap; horizontal-stretch: 1;
                        }
                        Switch { text: Lh.restricted ? "on" : "off"; checked: Lh.restricted; toggled => { Lh.set-restricted(self.checked); } }
                    }
                    if Lh.restart-needed : Text { text: "Restart the Lighthouse for this to take effect."; color: Theme.warn; font-size: Theme.font-small; }
                    HorizontalLayout {
                        spacing: 8px;
                        for n in Lh.allowed : Rectangle {
                            height: 30px;
                            border-radius: 15px;
                            background: Theme.selected;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 4px;
                                spacing: 6px;
                                Text { text: n; color: Theme.text; font-size: Theme.font-small; vertical-alignment: center; }
                                Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    y: 4px;
                                    border-radius: 11px;
                                    background: xa.has-hover ? Theme.warn : Theme.border;
                                    xa := TouchArea { clicked => { Lh.deny(n); } }
                                    Text { text: "×"; color: white; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                        if Lh.allowed.length == 0 : Text { text: "No phone on the list yet."; color: Theme.muted; font-size: Theme.font-small; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit { text <=> Lh.allow-name; placeholder-text: "name (anna-phone)"; width: 180px; }
                        LineEdit { text <=> Lh.allow-key; placeholder-text: "descriptor:x25519:… (from the phone)"; horizontal-stretch: 1; }
                        PrimaryButton { text: "Allow"; clicked => { Lh.allow(); } }
                    }
                    if Lh.allow-message != "" : Text { text: Lh.allow-message; color: Lh.allow-error ? Theme.warn : Theme.ok; font-size: Theme.font-small; }
                }
            }

            // Rooms
            if Lh.screen == LhScreen.rooms : VerticalLayout {
                padding: 24px;
                spacing: 14px;
                ScreenTitle { title: "Rooms"; sub: "Route ids only: a Lighthouse never knows a room's name or who is in it beyond device keys."; }
                TableHead { cols: ["Route", "Local online", "Linked Lighthouses", "Queued"]; weights: [2, 1.2, 2.2, 1.6]; }
                Rectangle {
                    vertical-stretch: 1;
                    if Lh.rooms.length == 0 : Text { text: Lh.on ? "No rooms yet." : "The Lighthouse is off."; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                    ScrollView {
                        VerticalLayout {
                            alignment: start;
                            for r in Lh.rooms : Rectangle {
                                height: 40px;
                                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 8px;
                                    Cell { text: r.id; horizontal-stretch: 2; font-family: "monospace"; }
                                    Cell { text: r.online + " of " + r.members; horizontal-stretch: 1.2; }
                                    Cell { text: r.linked; horizontal-stretch: 2.2; color: Theme.muted; }
                                    Cell { text: r.queued; horizontal-stretch: 1.6; }
                                }
                            }
                        }
                    }
                }
            }

            // Settings
            if Lh.screen == LhScreen.settings : sv2 := ScrollView {
                VerticalLayout {
                    width: sv2.visible-width;
                    padding: 24px;
                    spacing: 16px;
                    ScreenTitle { title: "Settings"; sub: "Saved to config.yaml; the beacon command line reads the same file. Limits are in force from the next start."; }
                    Card {
                        title: "This Lighthouse";
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: "Name"; color: Theme.muted; width: 150px; vertical-alignment: center; }
                            LineEdit { text <=> Lh.name; horizontal-stretch: 1; }
                        }
                        KeyValue { key: "Data folder"; value: Lh.data-dir; }
                        KeyValue { key: "Master key"; value: Lh.key-status; value-color: Lh.key-ok ? Theme.ok : Theme.warn; }
                        KeyValue { key: "Disk"; value: Lh.disk-status; value-color: Lh.disk-ok ? Theme.ok : Theme.warn; }
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: "Page with the code"; color: Theme.muted; width: 150px; vertical-alignment: center; }
                            Switch { text: Lh.page-on ? "served at / on the onion" : "off"; checked: Lh.page-on; toggled => { Lh.set-page(self.checked); } }
                        }
                        HorizontalLayout { alignment: start; SmallButton { text: "Check again"; clicked => { Lh.recheck(); } } }
                    }
                    Card {
                        title: "Appearance";
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: "Theme"; color: Theme.muted; width: 150px; vertical-alignment: center; }
                            ComboBox {
                                model: ["System", "Light", "Dark"];
                                current-index: Lh.theme-choice;
                                selected => { Lh.theme-choice = self.current-index; Lh.set-theme(self.current-index); }
                            }
                        }
                    }
                    Card {
                        title: "Limits";
                        GridLayout {
                            spacing: 12px;
                            Row {
                                Field { label: "Phones attached at once"; value <=> Lh.max-clients; }
                                Field { label: "Queue per phone and room"; value <=> Lh.queue-frames; unit: "frames"; }
                                Field { label: "Queue size per phone and room"; value <=> Lh.queue-mb; unit: "MB"; }
                            }
                            Row {
                                Field { label: "Keep queued frames"; value <=> Lh.queue-days; unit: "days"; }
                                Field { label: "Keep mailbox messages"; value <=> Lh.message-days; unit: "days"; }
                                Field { label: "Release delay (random up to)"; value <=> Lh.release-delay; unit: "s"; }
                            }
                        }
                        HorizontalLayout { alignment: start; PrimaryButton { text: "Save"; clicked => { Lh.save-settings(); } } }
                    }
                    Card {
                        title: "Backup";
                        Text { text: "A consistent copy of the database. Back up the master key separately: the copy is sealed with it."; color: Theme.muted; font-size: Theme.font-small; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit { text <=> Lh.backup-path; horizontal-stretch: 1; }
                            PrimaryButton { text: "Back up"; clicked => { Lh.backup(); } }
                        }
                    }
                    if Lh.settings-message != "" : Text { text: Lh.settings-message; color: Lh.settings-error ? Theme.warn : Theme.ok; font-size: Theme.font-small; }
                }
            }

            // Log
            if Lh.screen == LhScreen.log : VerticalLayout {
                padding: 24px;
                spacing: 14px;
                ScreenTitle { title: "Log"; sub: "Recent events, newest first: start and stop, links, refusals with their reason."; }
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.panel;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border;
                    if Lh.log.length == 0 : Text { text: "Nothing yet."; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                    ScrollView {
                        VerticalLayout {
                            padding: 8px;
                            alignment: start;
                            for l in Lh.log : HorizontalLayout {
                                padding: 6px;
                                spacing: 10px;
                                Text { text: l.time; color: Theme.muted; font-size: Theme.font-small; width: 72px; font-family: "monospace"; vertical-alignment: center; }
                                Dot { y: (parent.height - 10px) / 2; c: l.kind == 1 ? Theme.ok : l.kind == 2 ? Theme.warn : Theme.border; }
                                Text { text: l.text; color: Theme.text; font-size: Theme.font; wrap: word-wrap; horizontal-stretch: 1; }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Pharos Lighthouse";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 640px;
    min-height: 420px;
    background: Theme.bg;
    // Screenshots and tests switch light/dark here (Theme.dark follows Palette.color-scheme).
    public function set-dark(on: bool) { Palette.color-scheme = on ? ColorScheme.dark : ColorScheme.light; }
    /// Follow the system's light/dark setting again.
    public function set-system-theme() { Palette.color-scheme = ColorScheme.unknown; }
    LighthouseView { }
}
