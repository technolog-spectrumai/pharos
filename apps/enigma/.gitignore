# Node
node_modules/

# Build outputs
dist/
build/
target/
**/target/
# Per-profile dev build dirs (scripts/dev_target.sh) — one per running instance
# so two dev instances never queue behind one another's Cargo lock.
target-*/
**/target-*/
*.wasm
Cargo.lock
# ...except the vendored cryptorotor workspace, which commits its own lock (upstream does).
# The app crate's own Cargo.lock (apps/enigma/src-tauri) stays ignored.
!cryptorotor/Cargo.lock

# Enigma Builder (tools/enigma_builder) local output — the generated `custom`
# edition config. light/plus/pro stay checked in; this one never is.
apps/enigma/src-tauri/configs/build_config.custom.yaml

# Python tooling venvs (tools/enigma_builder, tools/map_packager)
tools/*/venv/
tools/*/.venv/
tools/*/__pycache__/
tools/*/**/__pycache__/
tools/*/.pytest_cache/

# PyInstaller spec, regenerated by tools/enigma_builder/package.sh on every run
# (its dist/ and build/ output is already covered above).
tools/*/*.spec

# Test artifacts
test-results/
playwright-report/
coverage/

# Logs & local env
*.log
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store

# Android signing material — a keystore or its passwords must never be committed.
# gen/android/.gitignore covers the generated project; these cover the repo root
# and anywhere else a stray copy could land. The committed fingerprint PIN file
# (apps/enigma/deploy/android-release-key.properties) is deliberately named so
# these patterns do not match it.
*.jks
*.keystore
*.p12
*.pfx
keystore.properties
key.properties
signing.properties
