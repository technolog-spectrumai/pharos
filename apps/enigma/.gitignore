# Enigma's own; the repo root's .gitignore covers the rest.

# Per-profile dev build dirs (scripts/dev_target.sh) — one per running instance
# so two dev instances never queue behind one another's Cargo lock.
target-*/
**/target-*/
*.wasm

# The `custom` Enigma edition: a local feature set of your own. The presets in
# configs/ stay checked in; this never is.
src-tauri/configs/build_config.custom.yaml

# Test artifacts
playwright-report/
.playwright/

# Android signing material — a keystore or its passwords must never be committed.
# gen/android/.gitignore covers the generated project; these cover anywhere
# else a stray copy could land. The committed fingerprint PIN file
# (deploy/android-release-key.properties) is deliberately named so these
# patterns do not match it.
*.jks
*.keystore
*.p12
*.pfx
keystore.properties
key.properties
signing.properties
