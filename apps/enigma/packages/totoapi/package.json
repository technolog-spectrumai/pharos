{
  "name": "totoapi",
  "version": "0.1.0",
  "private": true,
  "description": "The typed client for a toto platform server \u2014 capsules, jobs, workspaces and files over a capsule API token",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api/index.ts",
    "./platform": "./src/platform/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2",
    "@types/node": "^22",
    "typescript": "~5.6.3",
    "vitest": "^4.1.10"
  }
}
