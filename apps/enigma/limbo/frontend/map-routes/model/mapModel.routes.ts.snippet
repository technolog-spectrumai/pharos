// Parked route half of packages/rakotis/src/mapModel.ts (2026-07-27).
// Restore each block into the section it came from — the surrounding pin /
// location / region / coverage code is all still live in that file, so this is
// a re-insertion, not a file move. Indentation is verbatim.

// ── caps (beside MAP_NOTE_MAX_LEN / MAP_MIN_ZOOM) ───────────────────────────
export const MAP_ROUTE_MIN_POINTS = 2;
export const MAP_ROUTE_MAX_POINTS = 2000;

// ── stored shape (beside MapPin) ────────────────────────────────────────────
/** A user-drawn polyline of waypoints — never the output of a routing engine. */
export interface MapRoute {
  id: string;
  name: string;
  color?: string;
  /** [lat, lng] waypoints, MAP_ROUTE_MIN_POINTS..=MAP_ROUTE_MAX_POINTS. */
  points: [number, number][];
  /** Unix ms. */
  createdAt: number;
}

// ── wire shape (beside MapPinShare) ─────────────────────────────────────────
export interface MapRouteShare {
  type: "map_route";
  v: typeof MAP_SHARE_VERSION;
  name: string;
  color?: string;
  points: [number, number][];
}

// ── builder (beside buildPinShare) ──────────────────────────────────────────
export function buildRouteShare(route: MapRoute): MapRouteShare {
  const share: MapRouteShare = {
    type: "map_route",
    v: MAP_SHARE_VERSION,
    name: clampName(route.name),
    points: route.points.slice(0, MAP_ROUTE_MAX_POINTS),
  };
  if (route.color && isHexColor(route.color)) share.color = route.color;
  return share;
}

// ── validator (beside validatePinShare) ─────────────────────────────────────
export function validateRouteShare(x: unknown): MapRouteShare | null {
  if (!isRecord(x)) return null;
  if (x.type !== "map_route" || x.v !== MAP_SHARE_VERSION) return null;
  if (!isValidName(x.name)) return null;
  const pts = x.points;
  if (!Array.isArray(pts) || pts.length < MAP_ROUTE_MIN_POINTS || pts.length > MAP_ROUTE_MAX_POINTS) {
    return null;
  }
  const points: [number, number][] = [];
  for (const p of pts) {
    if (!Array.isArray(p) || p.length !== 2 || !isValidLat(p[0]) || !isValidLng(p[1])) return null;
    points.push([p[0], p[1]]);
  }
  const share: MapRouteShare = {
    type: "map_route", v: MAP_SHARE_VERSION, name: clampName(x.name), points,
  };
  if (isHexColor(x.color)) share.color = x.color;
  return share;
}

// ── coverage (goes INSIDE the existing `── Coverage ──` block, which stays:
//    pointInBbox / regionCovers / coveredByAny are load-bearing for pins,
//    locations and the whole shared layer) ────────────────────────────────────
/** A route counts as covered when ANY waypoint is: a line crossing an imported
 *  region should draw the part that has a basemap under it. */
export function routeCovered(
  regions: readonly MapRegionManifest[],
  points: readonly [number, number][],
): boolean {
  return points.some(([lat, lng]) => coveredByAny(regions, lat, lng));
}

// ── services/mapData.ts — the whole `── Routes ──` block ────────────────────
// (NS_ROUTES sat beside NS_PINS / NS_REGIONS at the top of the file.)
const NS_ROUTES = "map:routes";

export async function listRoutes(): Promise<MapRoute[]> {
  return readList<MapRoute>(NS_ROUTES);
}

export async function upsertRoute(route: MapRoute): Promise<MapRoute[]> {
  const all = await listRoutes();
  const i = all.findIndex((r) => r.id === route.id);
  if (i >= 0) all.splice(i, 1, route);
  else all.unshift(route);
  await persist(NS_ROUTES, all);
  return all;
}

export async function removeRoute(id: string): Promise<MapRoute[]> {
  const all = (await listRoutes()).filter((r) => r.id !== id);
  await persist(NS_ROUTES, all);
  return all;
}
