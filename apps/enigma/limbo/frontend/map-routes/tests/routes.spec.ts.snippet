// Parked route tests (2026-07-27). Sources, in order:
//   packages/rakotis/tests/unit/mapModel.test.ts  — describe('mapModel — route share') + the routeCovered case
//   packages/rakotis/tests/unit/mapData.test.ts   — the route() fixture + describe('mapData — routes')
//   apps/enigma/tests/unit/sharedMapLayer.test.ts — the ROUTE fixture + the coverage case
//   apps/enigma/tests/component/maps.test.ts      — the route MapShareCard case

// ── mapModel.test.ts ──
describe("mapModel — route share", () => {
  const route: MapRoute = {
    id: "r1", name: "Loop", points: [[52.4, 16.9], [52.41, 16.91], [52.42, 16.92]], createdAt: 1,
  };

  it("build → validate roundtrip", () => {
    const share = buildRouteShare(route);
    expect(validateRouteShare(share)).toEqual(share);
  });

  it("rejects too few / too many / malformed points", () => {
    const base = { type: "map_route", v: 1, name: "x" };
    expect(validateRouteShare({ ...base, points: [[1, 2]] })).toBeNull();
    expect(
      validateRouteShare({ ...base, points: Array(MAP_ROUTE_MAX_POINTS + 1).fill([1, 2]) }),
    ).toBeNull();
    expect(validateRouteShare({ ...base, points: [[1, 2], [91, 0]] })).toBeNull();
    expect(validateRouteShare({ ...base, points: [[1, 2], [3]] })).toBeNull();
    expect(validateRouteShare({ ...base, points: "nope" })).toBeNull();
  });
});
  it("routeCovered needs only one waypoint inside", () => {
    const inside: [number, number][] = [[52.4, 16.9], [52.45, 16.95]];
    const crossing: [number, number][] = [[0, 0], [52.4, 16.9]];
    const outside: [number, number][] = [[0, 0], [1, 1]];
    expect(routeCovered([POZNAN], inside)).toBe(true);
    expect(routeCovered([POZNAN], crossing)).toBe(true);
    expect(routeCovered([POZNAN], outside)).toBe(false);
  });

// ── mapData.test.ts ──
const route = (id: string): MapRoute => ({
  id, name: "Route", points: [[52.4, 16.9], [52.5, 17.0]], createdAt: 1,
});
describe("mapData — routes", () => {
  it("full CRUD round-trip", async () => {
    await upsertRoute(route("r1"));
    await upsertRoute(route("r2"));
    expect((await listRoutes()).map((r) => r.id)).toEqual(["r2", "r1"]);
    await removeRoute("r2");
    expect((await listRoutes()).map((r) => r.id)).toEqual(["r1"]);
  });
});

// ── sharedMapLayer.test.ts ──
const ROUTE: MapShare = {
  type: "map_route", v: 1, name: "Walk", points: [[52.4, 16.9], [52.45, 16.95]],
};
  it("a route counts as covered when any waypoint is", () => {
    const crossing: MapShare = {
      type: "map_route", v: 1, name: "Long", points: [[0, 0], [52.4, 16.9]],
    };
    expect(derive([msg("r", crossing)])[0].covered).toBe(true);
  });


// ── maps.test.ts ──
  it("renders a route card with its point count", () => {
    const message = makeMessage({
      type: "map_route", v: 1, name: "Loop", points: [[52.4, 16.9], [52.5, 17.0]],
    });
    const wrapper = mount(MapShareCard, { props: { message }, global: GLOBAL() });
    expect(wrapper.text()).toContain("Loop");
    expect(wrapper.text()).toContain("2 points");
  });
