    linkedBadge: "Synced",
    linkedBadgeTitle: "You already have a peer link with this contact.",
    linksTitle: "Peer links",
    linksHint: "People you sync selected data with, directly and continuously. Each direction is granted separately — what you share and what they share are two different decisions.",
    empty: "No peer links yet. Pick a contact above and choose what each of you shares.",
    scopeCalendar: "Calendar",
    scopeCalendarDesc: "The meetings you organise — title, time, place and notes. Meetings other people invited you to are never shared.",
    scopeHistory: "Chat history",
    scopeHistoryDesc: "Past messages from rooms you are both already in — including what other members wrote there.",
