{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",

    /* Shared workspace packages resolved as source */
    "baseUrl": ".",
    "paths": {
      "rakotis": ["../../node_modules/rakotis/src/index.ts"],
      "rakotis/*": ["../../packages/rakotis/src/*"],
      "wisteria/*.vue": ["../../rutile/packages/wisteria/src/components/*.vue"],
      "wisteria/*": ["../../rutile/packages/wisteria/src/*"],
      "wisteria": ["../../rutile/packages/wisteria/src/index.ts"],
      "petalite/*.vue": ["../../rutile/packages/petalite/src/components/*.vue"],
      "petalite/*": ["../../rutile/packages/petalite/src/*"],
      "petalite": ["../../rutile/packages/petalite/src/index.ts"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
