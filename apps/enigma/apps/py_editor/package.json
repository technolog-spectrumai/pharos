{
  "name": "py_editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Python Editor \u2014 edit and run Python in a Compute Capsule on a toto platform server. Tauri 2 desktop app.",
  "scripts": {
    "dev": "vite",
    "dev:tauri": "node scripts/tauri-dev-server.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "ace-builds": "^1.44.0",
    "petalite": "*",
    "tailwindcss": "^4.3.0",
    "totoapi": "*",
    "vue": "^3.5.38",
    "vue-i18n": "^9.14.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "typescript": "~5.6.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.12"
  }
}
