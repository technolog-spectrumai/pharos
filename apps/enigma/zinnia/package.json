{
  "name": "zinnia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Zinnia — an office suite (drawings, sheets, slides, documents) for the toto platform. Tauri 2 desktop app.",
  "workspaces": [
    "apps/*",
    "packages/petalite",
    "packages/padova"
  ],
  "scripts": {
    "dev": "npm run dev --workspace lazurite",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:rust": "cargo test --workspace",
    "test:all": "npm run test && npm run test:rust"
  }
}
