{
  "name": "sketch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sketch \u2014 the drawing board: SVG editing and PNG export. Tauri 2 desktop app.",
  "scripts": {
    "dev": "vite",
    "dev:tauri": "node scripts/tauri-dev-server.mjs",
