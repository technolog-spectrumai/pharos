    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "ace-builds": "^1.44.0",
    "html5-qrcode": "^2.3.8",
    "nanoid": "^5.1.16",
    "padova": "*",
    "petalite": "*",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.38",
    "vue-i18n": "^9.14.5",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
